<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  T1-2 风格门禁：聚焦刚完成的 BasePage 拆分成果，防止回退。
  规则：
    - FileLength   : 单文件 ≤ 1000 行（杜绝“千行类”，对应整改计划 R1）
    - EmptyCatchBlock: 禁止空 catch（对应“514 处宽泛 catch”清理成果；允许仅注释的空 catch）
    - UnusedImports: 禁止未使用导入
  作用域通过 maven-checkstyle-plugin 的 <includes> 限定到重构包，避免误伤存量代码；
  后续可逐步放开到全量源码。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="SuppressionFilter">
        <property name="file" value="checkstyle-suppressions.xml"/>
    </module>

    <!-- FileLength 为 Checker 级检查（按文件），不属于 TreeWalker -->
    <module name="FileLength">
        <property name="max" value="1000"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="TreeWalker">
        <module name="EmptyCatchBlock">
            <!-- 允许“仅注释”的空 catch（如刻意忽略的异常），但禁止完全空白 -->
            <property name="commentFormat" value=".*"/>
        </module>

        <module name="UnusedImports"/>
    </module>
</module>
