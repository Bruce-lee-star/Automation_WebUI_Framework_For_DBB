<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
    <artifactId>Automation_WebUI_Framework_BDD</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Automation WebUI Framework (Parent)</name>
    <description>Enterprise multi-module automation framework: core / reporting / api / web / route / test-automation</description>

    <!-- T3-1: 物理多模块拆分。依赖方向（均收敛到 core，无环）：
         core <- reporting / api <- web <- route <- test-automation -->
    <modules>
        <module>core</module>
        <module>reporting</module>
        <module>api</module>
        <module>web</module>
        <module>codegen</module>
        <module>route</module>
        <module>test-automation</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- D6-3：serenity 升级路径见 docs/serenity-upgrade-path.md（摩擦点矩阵 + 回归清单 + SOP）。
             历史：CORE-P0-1 为适配 jackson 2.18.3 上界曾被动降到 4.2.0；版本已集中此处，升级只改本属性 + 同步配套覆盖项。 -->
        <serenity.version>4.2.0</serenity.version>
        <serenity.cucumber.version>4.2.0</serenity.cucumber.version>
        <playwright.version>1.62.0</playwright.version>
        <!-- JUnit 5（Jupiter）升级：测试框架由 JUnit 4 迁 JUnit 5（设计见 docs/architecture-review/17_整改专项设计_JUnit5升级.md）。
             保持 Serenity 4.2.0；junit-jupiter 版本须与 serenity-junit5:4.2.0 传递引入的 junit-jupiter 对齐
             （在线 mvn dependency:tree 校准，requireUpperBoundDeps 门禁）。默认 5.11.4 与 cucumber-junit-platform-engine:7.31 的 junit-platform 上界兼容。 -->
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <!-- 注意：junit-platform-* 在 JUnit 5 时代的版本线是 1.x（而非 5.x）。
             必须 ≥ 1.14.0：cucumber-junit-platform-engine:7.31.0（junit-bom 5.14.0）的 CucumberTestEngine
             引用 org.junit.platform.engine.support.discovery.DiscoveryIssueReporter（1.13+ 才引入），
             1.11.4 缺失该类会导致运行期 NoClassDefFoundError / Cucumber 引擎无法发现用例。 -->
        <junit.platform.version>1.14.0</junit.platform.version>

        <typesafe.config.version>1.4.5</typesafe.config.version>
        <gson.version>2.14.0</gson.version>
        <json.path.version>2.9.0</json.path.version>
        <cucumber.version>7.31.0</cucumber.version>
        <json.version>20240303</json.version>
        <!-- T2-8：报告模板引擎。serenity 4.2.0 的 serenity-model 直接依赖 freemarker 2.3.33，RequireUpperBoundDeps 上界即 2.3.33，故锁定 2.3.33；SummaryReportGenerator 同步改用 Configuration.VERSION_2_3_33 常量与之匹配。 -->
        <freemarker.version>2.3.33</freemarker.version>
        <!-- T2-8/方案A：汇总报告生成的绑定阶段。
             由 test-automation 的 pom 内联 exec-maven-plugin 引用（绑定 verify），
             生命周期上晚于 post-integration-test 的 serenity:aggregate，
             由 Maven 阶段（而非同阶段插件声明顺序）保证「聚合完成后再生成」。
             仅 test-automation（唯一含 framework-reporting 的业务测试模块）执行；
             根聚合模块与框架模块无此 exec，天然不触发。 -->
        <summary.report.phase>verify</summary.report.phase>

        <!-- 安全漏洞修复版本 -->
        <logback.version>1.5.34</logback.version>
        <jackson.version>2.18.3</jackson.version>
        <json-smart.version>2.5.2</json-smart.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>

        <!-- 门禁（Phase 1 收尾）：JaCoCo 覆盖率 + Checkstyle 风格 -->
        <jacoco.version>0.8.12</jacoco.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <!-- 多模块下子模块 basedir 不是根，需用 multiModuleProjectDirectory 定位根级配置 -->
        <checkstyle.config.location>${maven.multiModuleProjectDirectory}/checkstyle.xml</checkstyle.config.location>

        <!-- SpotBugs 门禁（T1-3）版本与排除过滤器 -->
        <spotbugs.plugin.version>4.9.8.5</spotbugs.plugin.version>
        <spotbugs.version>4.9.8</spotbugs.version>

        <!-- CVE 门禁（T1-4）：OSV-Scanner 配置 -->
        <cve.gate.skip>false</cve.gate.skip>

        <!-- 默认跑 @route；CI 可用 -Dtags=@api 覆盖（见 test-automation 的 failsafe 配置） -->
        <tags>@route</tags>

        <!-- 重试：默认 0（不重试），CI 可通过 -DrerunFailingTestsCount=N 覆盖 -->
        <rerunFailingTestsCount>0</rerunFailingTestsCount>
    </properties>

    <!-- ENG-P0-2：依赖下沉。全部外部依赖改在 <dependencyManagement> 统一钉版本，
         各模块在自身 <dependencies> 中显式声明所真正用到的依赖（见各模块 pom），
         不再由父 POM <dependencies> 全量继承，模块边界与依赖来源可在 pom 直接辨识。 -->
    <dependencyManagement>
        <dependencies>
        <!-- ==================== 离线中文→英文命名（代码生成器用，纯 Java、离线、无模型权重） ==================== -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>1.0.2</version>
        </dependency>
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
            <version>2.5.1</version>
        </dependency>

        <!-- ==================== Serenity BDD ==================== -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
            <version>${serenity.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
            <version>${serenity.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-support</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.httpcomponents</groupId>
                    <artifactId>httpclient</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-cucumber</artifactId>
            <version>${serenity.cucumber.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Serenity JUnit 5（JUnit4 的 serenity-junit 已弃用；2026-09-11 JUnit5 升级，保持 serenity 4.2.0） -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-junit5</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5（Jupiter）：SerenityJUnit5Extension 与 @Suite(Cucumber) 运行基座。
             版本统一 ${junit.jupiter.version}，与 cucumber-junit-platform-engine:${cucumber.version} 的 junit-platform 上界一致（requireUpperBoundDeps）。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- @Suite 套件（Cucumber runner 迁移目标）：驱动 cucumber-junit-platform-engine -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 统一 junit-platform-launcher 版本：cucumber-junit-platform-engine 传递 1.11.0，junit-platform-suite 传递 1.11.4；
             RequireUpperBoundDeps 要求同 artifact 版本一致，钉到 1.11.4（与 platform 线对齐）。 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- junit-platform-engine/commons 必须提升到 1.14.0：
             cucumber-junit-platform-engine:7.31.0（junit-bom 5.14.0）的 CucumberTestEngine.discover 引用
             org.junit.platform.engine.support.discovery.DiscoveryIssueReporter，该类在 platform 1.11.4 缺失
             （1.13+ 才引入）→ 运行期 NoClassDefFoundError，Cucumber 引擎无法发现用例。
             launcher/suite 维持 ${junit.platform.version}=1.11.4（离线仓库无 1.14.0），engine/commons 前向兼容。 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-engine</artifactId>
            <version>1.14.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-commons</artifactId>
            <version>1.14.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Cucumber 7 JUnit Platform 引擎（替代 JUnit4 的 @RunWith(CucumberWithSerenity)） -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Serenity Screenplay -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
            <version>${serenity.version}</version>
        </dependency>

        <!-- API Testing -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
            <version>${serenity.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- RestAssured/HttpClient 运行时需要 commons-logging(LogFactory)，上方 serenity-* 将其全部 exclude 且未显式声明，
             导致 RestPostJob 等 POST 实现类初始化时 NoClassDefFoundError。此处显式补回。 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- commons-lang3 原先未显式声明，仅靠传递依赖拉入且解析到 2014 年的 3.3.1（存在已知 CVE）。显式声明并升级到 3.17.0。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.19.0</version>
        </dependency>

        <!-- Logging - Logback (SLF4J implementation) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>${json.path.version}</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>

        <!-- Selenium support 跟随 Serenity 4.2.0 官方配套的 4.23.1（CORE-P0-1 降 serenity 以适配 jackson 2.18.3）。 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <version>4.23.1</version>
        </dependency>

        <!-- Playwright -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Testing Frameworks：JUnit 4（junit:junit）已弃用（JUnit5 升级），不再纳入 DM；
             各模块改用 junit-jupiter-*。hamcrest-core 仍由 Cucumber/AssertJ 传递消费，版本钉于下方 DM。 -->

        <!-- ArchUnit：架构分层门禁（T0-1），仅测试期使用 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Hamcrest for assertions (used by Cucumber) -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-core</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- Utils -->
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>${typesafe.config.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <!-- Playwright 1.62.0 / axe-core 4.10.2 传递上界钉（ENG-P0-2 Enforcer RequireUpperBoundDeps）：
             commons-io 由 axe-core 4.10.2 拉到 2.18.0；commons-compress 由 axe-core 4.10.2 拉到 1.27.1 -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.27.1</version>
        </dependency>
        <dependency>
            <groupId>com.deque.html.axe-core</groupId>
            <artifactId>playwright</artifactId>
            <version>4.10.2</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.0.1</version>
        </dependency>

            <!-- 覆盖传递性依赖版本，修复安全漏洞 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>json-smart</artifactId>
                <version>${json-smart.version}</version>
            </dependency>
            <!-- T1-5 依赖收敛：jackson 三件套统一钉到 ${jackson.version}（与 jackson-core 一致），消除版本漂移。
                 CORE-P0-1 / ENG-P0-2 修正：core 的 SensitiveDataSanitizer 直接使用 jackson-databind（脱敏 JSON 解析），
                 原经继承的 serenity 传递引入，下沉后须显式钉版本。 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>
            <!-- CORE-P0-1 / 降 serenity 到 4.2.0：serenity 父 POM 在 DM 钉 byte-buddy 1.14.18，
                 但 selenium-support 4.38.0 传递 byte-buddy 1.17.8，requireUpperBoundDeps 要求统一上限。
                 此处显式钉 1.17.8 覆盖 serenity 父的 1.14.18，消除版本漂移。 -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>1.17.8</version>
            </dependency>
            <!-- CORE-P0-1 / 降 serenity 到 4.2.0：serenity 父 POM 在 DM 钉 guava 33.2.1-jre，
                 但 web 显式使用 33.5.0-jre，requireUpperBoundDeps 要求统一上限。钉 33.5.0-jre 覆盖 serenity 父。 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.5.0-jre</version>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.48.0</version>
            </dependency>
            <dependency>
                <groupId>org.htmlunit</groupId>
                <artifactId>htmlunit</artifactId>
                <version>4.4.0</version>
            </dependency>
            <!-- T4-4：将 Serenity 传递的 Cucumber 版本钉为显式属性，作为 README 技术栈表的单一事实来源（doc-drift 校验据此比对） -->
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-core</artifactId>
                <version>${cucumber.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <skipTests>false</skipTests>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <useModulePath>false</useModulePath>
                    <!-- fork JVM 整体超时兜底，防单用例死锁拖垮整轮（详见原注释） -->
                    <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- ⚠ JDK16+ 强封装：Serenity REST(RestSpecificationFactory) 在静态初始化时用 ByteBuddy
                         反射注入类，需 java.base 打开 java.lang(ClassLoader.getPackage/defineClass)；
                         java.lang.reflect 供 Mockito/Serenity 反射增强；java.util 供 RestAssured 的 Groovy 反射。 -->
                    <!-- @{jacocoArgLine} 由 jacoco prepare-agent 在 initialize 阶段注入（覆盖率探针），
                         未启用 jacoco 时该属性为空，不影响原 add-opens 强封装配置 -->
                    <argLine>@{jacocoArgLine} -Dfile.encoding=UTF-8 -XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>

            <!-- JaCoCo：覆盖率探针。prepare-agent 为所有模块注入 agent（jacocoArgLine），
                 实际 report/check 仅在 test-automation（含测试）中执行，见该模块 pom。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                            <!-- 排除故意损坏的测试夹具（WEB-P1-3 坏类扫描用例），避免 JaCoCo 对其 instrumentation 报良性噪声。
                                 JaCoCo excludes 用 * 通配（非 Ant 的 **），按内部类名（/ 分隔，无 .class 后缀）匹配 -->
                            <excludes>
                                <exclude>com/hsbc/cmb/hk/dbb/automation/framework/web/listener/resiliencypkg/*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle：风格门禁（T1-2）。仅校验刚完成的重构包，failOnViolation 直接卡 verify。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>${checkstyle.config.location}</configLocation>
                    <!-- D7-3 规范约束框架生产代码：测试源（负向用例刻意触发/忽略异常）不纳入本门禁 -->
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <includes>**/framework/**</includes>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Enforcer：依赖治理门禁（T1-5）。
                 requireUpperBoundDeps 防止传递依赖版本被低版本覆盖（如 selenium 4.15 vs 4.38 问题复发）；
                 banDuplicatePomDependencyVersions 防止同一依赖在 dependencyManagement 多版本声明；
                 requireJavaVersion/requireMavenVersion 锁定构建环境。存量违规通过渐进式启用治理，新代码零容忍。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-build-env</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.6.0</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireUpperBoundDeps/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs：字节码静态缺陷门禁（T1-3）。
                 策略（D6-2）：① 存量基线按包拆分 + 限期消除（见各模块 spotbugs-exclude.xml 头注释，含 owner/SLA/方式）；
                 ② 新增违规硬门禁已生效——spotbugs-check 绑 verify 阶段、failOnError=true，excludeFilter 仅冻结已知基线项，
                    任何未列入基线的新 SpotBugs 违规（Medium+）将导致 verify 失败，即「新增违规必须为 0」；
                 ③ 消除后对应 <Match> 从基线移除，禁止「冻结式」留存。 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <includeTests>true</includeTests>
                    <!-- 模块级排除过滤器：更新基线用 spotbugs:updateExcludeFilter 自动生成抑制项；
                         各模块独立文件避免反应器内互相覆盖。 -->
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- CVE 门禁前置（T1-4）：在 package 阶段将各模块安装到本地 .m2，
                 使后续 verify 阶段的 OSV-Scanner pom 扫描能解析 intra-project 兄弟模块 framework-*，
                 避免“failed resolution”误判与漏检。对 mvn test 无影响（test 在 package 之前）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>install-modules-for-sca</id>
                        <phase>package</phase>
                        <goals>
                            <goal>install</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- CVE 门禁（T1-4）—— 企业级免 key 方案：Google OSV-Scanner（OSV.dev，聚合 NVD/GHSA）。
                 OWASP dependency-check 13.0.0 在 2026 下强制要求 NVD API Key 且不可绕过（无 key 连报告都出不了），
                 故改用同源情报、免 key、Maven 可集成的 OSV-Scanner：递归扫描全部 pom.xml（依赖已在 package 阶段装入 .m2），
                 osv-scanner.toml 冻结当前已知漏洞作为【基线】，任何【新增漏洞 ID】使构建失败（阻断回归）。
                 运行：CI 先行 tools/install-osv-scanner.ps1 安装二进制并设 OSV_CVE_GATE_REQUIRED=true 强制；
                       本地无二进制时仅告警跳过（不阻断 dev 构建）。仅根模块执行一次（inherited=false）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>osv-scanner-cve-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <inherited>false</inherited>
                        <configuration>
                            <executable>powershell</executable>
                            <arguments>
                                <argument>-NoProfile</argument>
                                <argument>-ExecutionPolicy</argument>
                                <argument>Bypass</argument>
                                <argument>-File</argument>
                                <argument>${project.basedir}/tools/cve-gate.ps1</argument>
                            </arguments>
                            <skip>${cve.gate.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
