<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
    <artifactId>Automation_WebUI_Framework_BDD</artifactId>
    <version>1.0.0</version>
    <description>Automation framework with Serenity, Playwright and Cucumber</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <serenity.version>4.3.4</serenity.version>
        <serenity.cucumber.version>4.3.4</serenity.cucumber.version>
        <playwright.version>1.58.0</playwright.version>
        <junit.version>4.13.2</junit.version>

        <typesafe.config.version>1.4.2</typesafe.config.version>
        <gson.version>2.10.1</gson.version>
        <json.path.version>2.9.0</json.path.version>
        <json.version>20240303</json.version>

        <!-- 安全漏洞修复版本 -->
        <spring.version>6.2.19</spring.version>
        <logback.version>1.5.34</logback.version>
        <jackson.version>2.21.4</jackson.version>
        <json-smart.version>2.5.2</json-smart.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>

        <!-- 重试：默认 0（不重试），CI 可通过 -DrerunFailingTestsCount=N 覆盖 -->
        <rerunFailingTestsCount>0</rerunFailingTestsCount>
    </properties>

    <dependencies>
        <!-- ==================== 离线中文→英文命名（代码生成器用，纯 Java、离线、无模型权重） ==================== -->
        <!-- jieba 中文分词：把中文元素名切成语义词，命中 UI 词库则映射英文，否则回退拼音 -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>1.0.2</version>
        </dependency>
        <!-- pinyin4j：未命中语义词库时的拼音兜底，保证稳定生成合法英文标识符 -->
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
            <version>2.5.1</version>
        </dependency>

        <!-- ==================== Serenity BDD ==================== -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
            <version>${serenity.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
            <version>${serenity.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-support</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.httpcomponents</groupId>
                    <artifactId>httpclient</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-cucumber</artifactId>
            <version>${serenity.cucumber.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- #################################################################### -->
        <!-- #################### Serenity + JUnit 4 #################### -->
        <!-- #################################################################### -->
        <!-- Serenity JUnit 4 -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-junit</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ==================== Serenity Screenplay ==================== -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
            <version>${serenity.version}</version>
        </dependency>

        <!-- ==================== API Testing ==================== -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
            <version>${serenity.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        
        <!-- Spring Context for @Autowired support -->
        <!-- ⭐ 修复 P3-33：commons-lang3 原先未在 pom 中显式声明，仅靠传递依赖拉入，
             构建脆弱（传递路径一变就可能编译失败）；且实际解析到的是 2014 年的 3.3.1，
             存在若干已知 CVE。这里显式声明并升级到 3.17.0。
             兼容性：项目仅使用 org.apache.commons.lang3.StringUtils（6 处，均在 api 模块），
             其核心 API 在 3.x 全系列保持稳定向后兼容，升级风险可控。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.17.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>
        
        <!-- Logging - Logback (SLF4J implementation) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>${json.path.version}</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>

        <!-- Selenium support (required by Serenity internally)
             ⭐ 修复 P1-12：原实现从 serenity-core / serenity-cucumber 排除全部 selenium-*，
             再显式钉死 selenium-support:4.15.0。但 Serenity 4.3.4 官方配套的是
             selenium.version=4.38.0（见 serenity-bdd:4.3.4 父 POM）——4.15.0 与 4.38.0
             相隔 23 个 minor 版本，Serenity 内部类引用的 Selenium API 在 4.15.0 上可能
             并不存在，运行时会以 NoSuchMethodError / NoClassDefFoundError 的形式暴露。
             这里对齐到 Serenity 官方配套的 4.38.0。
             注：排除 Serenity 自带 selenium 是为配合 Playwright 做依赖瘦身，该意图保留；
             但"手动钉的版本"必须与 Serenity 期望的一致，否则瘦身即埋雷。 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <version>4.38.0</version>
        </dependency>

        <!-- ==================== Playwright ==================== -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- ==================== Testing Frameworks ==================== -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
        </dependency>

        <!-- Hamcrest for assertions (used by Cucumber) -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-core</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- ==================== Utils ==================== -->
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>${typesafe.config.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deque.html.axe-core</groupId>
            <artifactId>playwright</artifactId>
            <version>4.9.1</version>
        </dependency>
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
            <version>0.10.2</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.0.1</version>
        </dependency>

    </dependencies>


    <dependencyManagement>
        <dependencies>
            <!-- 覆盖传递性依赖版本，修复安全漏洞 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>json-smart</artifactId>
                <version>${json-smart.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ⭐ 修复 P1-13：原注释写"确保 surefire 支持 JUnit5"，与事实不符。
                 本项目实际使用 JUnit 4.13.2（见 <junit.version> 与 serenity-junit），
                 并未引入 junit-jupiter / junit-platform，因此不存在 JUnit5 场景。
                 该矛盾注释会误导维护者按 JUnit5 的思路排查问题。
                 说明：surefire 2.x/3.x 原生同时支持 JUnit4 与 JUnit5，此处无需额外适配。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <skipTests>false</skipTests>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <useModulePath>false</useModulePath>
                    <!-- ⭐ 修复 D-1：原配置无全局超时，单个用例 driver.quit 阻塞/死锁会让整个套件挂起、CI 永不返回。
                         forkedProcessTimeoutInSeconds 在 fork 的 JVM 整体超时（含所有用例）后强制 kill 并打印线程栈，
                         避免 CI 永久等待。300s 为单次运行上限，可按项目规模调整。 -->
                    <!-- ⚠️ 定位说明：本值是【防死锁的最后防线】，不是时间预算，
                         请勿靠调大它来"让慢测试跑完"。
                         它触发时会【强杀整个 fork JVM】：未完成的用例结果全部丢失，
                         并且会把"被中断"误报成失败（曾出现 300s 触发产生一批假失败，
                         被误判为代码回归）。
                         真正的用例级保护请用 JUnit 的 @Rule Timeout / @Test(timeout=...)，
                         它只失败单个用例且能精确定位，不影响其余结果。
                         实测 384 个用例中 280+ 个纯单元测试≈0s，耗时集中在 4 个
                         真实浏览器测试类（合计约 335s），故此处留足约 5 倍余量。 -->
                    <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
                    <!-- 单 fork JVM 跑全部用例（forkCount=1 reuseForks=true），超时兜底防止单用例死锁拖垮整轮；
                         若需更强的用例级隔离，可改 reuseForks=false（代价是启动更慢）。 -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>-XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang.reflect=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <useFile>false</useFile>
                    <rerunFailingTestsCount>${rerunFailingTestsCount}</rerunFailingTestsCount>
                    <forkCount>1</forkCount>
                    <!-- ⭐ 修复 A1：failsafe 运行 Cucumber 主流程（*IT / CucumberTestRunner），
                         原配置无全局超时，Playwright 导航/采集阻塞会让整轮 CI 永久挂起。
                         该超时作用于 fork 的 JVM 整体（含全部 scenario），超时后强制 kill 并打印线程栈。
                         600s 为单次运行上限，可按项目规模调整。 -->
                    <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/integration/**/*Test.java</include>
                        <include>**/CucumberTestRunner*.java</include>
                    </includes>
                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <useModulePath>false</useModulePath>
                    <argLine>-XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang.reflect=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <serenity.outputDirectory>${project.build.directory}/site/serenity</serenity.outputDirectory>
                        <cucumber.filter.tags>${tags}</cucumber.filter.tags>
                    </systemPropertyVariables>
                    <failIfNoTests>false</failIfNoTests>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>net.serenity-bdd.maven.plugins</groupId>
                <artifactId>serenity-maven-plugin</artifactId>
                <version>${serenity.version}</version>
                <executions>
                    <execution>
                        <id>serenity-reports</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/serenity</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-summary-report</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.hsbc.cmb.hk.dbb.automation.report.SummaryReportGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/site/serenity</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>target</directory>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>serenity-reports</directory>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>