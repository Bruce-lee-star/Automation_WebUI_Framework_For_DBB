<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>Automation_WebUI_Framework_BDD</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>pw-codegen</artifactId>
    <name>Automation Framework - Codegen</name>

    <properties>
        <!--
          D7-3「禁止静默吞异常」门禁：codegen 存量 79 处空 catch（交互式 picker 的 best-effort
          UI 代码密集），尚未治理。为让门禁对其余模块真实生效且不误伤构建，此处显式跳过；
          待 79 处治理完成后删除本属性，codegen 自动纳入门禁。
        -->
        <checkstyle.skip>true</checkstyle.skip>
    </properties>
    <description>Optional code-generator (role-element picker / page-object generator) extracted from
        framework-web. Depends on framework-web; injected into web at runtime via
        java.util.ServiceLoader (SPI). When absent from the classpath, web behaves exactly as before
        (codegen disabled by default) — zero behavioural regression.</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-web-ui</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!-- 依赖治理（内网隔离清单）：pw-web-ui 的框架级 glue **确实使用** Cucumber，故其三件套
                     （cucumber-core / cucumber-java / datatable）为 compile 作用域并向下游传递；而本模块
                     全量零 io.cucumber 引用、也不跑 Cucumber，继承整条 Cucumber 栈（十余个 formatter +
                     gherkin 等）纯属污染且命中隔离清单，故在本模块逐一排除。 -->
                <exclusion>
                    <groupId>io.cucumber</groupId>
                    <artifactId>cucumber-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.cucumber</groupId>
                    <artifactId>cucumber-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.cucumber</groupId>
                    <artifactId>datatable</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ENG-P0-2：codegen 实际用到的外部依赖（原由根 <dependencies> 继承，现显式声明） -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
        </dependency>
        <!-- 依赖治理：原此处声明 serenity-cucumber，但本模块全量零 io.cucumber / net.serenitybdd.cucumber
             引用（也不跑 Cucumber），属无用声明且其 cucumber-* 传递依赖命中内网隔离清单 —— 已移除。
             若将来确需（如 codegen 自己要跑 Cucumber），请先给出真实调用点再恢复。 -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- selenium-support：serenity 公开 API 引用 org.openqa.selenium.support.ui.*（如 ExpectedCondition） -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>
        <!-- ENG-P0-2：NlsNameTranslator（中文→英文标识符）下沉至 codegen 后，jieba + pinyin4j 仅 codegen 依赖 -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
        </dependency>

        <!-- CT2-09 / CT2-20：codegen 首次引入模块内单测，守卫「按 Page/BrowserContext 的静态缓存
             必须能被 cleanup* / clearAll 真正回收」这一契约（纯 JUnit 4，不依赖 Serenity）。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
