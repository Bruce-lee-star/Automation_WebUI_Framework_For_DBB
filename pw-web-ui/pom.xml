<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>Automation_WebUI_Framework_BDD</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>pw-web-ui</artifactId>
    <name>pw-web-ui (Web/UI automation)</name>
    <description>Web/UI layer: framework.web (Playwright). Depends on pw-core, reporting, api. Excludes route.</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ⭐ SessionManager META 并发缓存：Guava LoadingCache（concurrencyLevel 分段锁，满足多线程读盘 IO 竞争）。
             版本由根 dependencyManagement 统一钉 33.5.0-jre，此处无需重复声明 <version>。 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- ENG-P0-2：web 实际用到的外部依赖（原由根 <dependencies> 继承，现显式声明） -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
        <!-- gson：AxeCoreScriptProvider 将 axe.run 结果 JSON 映射为框架自有结果模型（解耦 Deque axe-core 包装器后新增）。
             版本由根 dependencyManagement 统一钉（${gson.version}）。 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- selenium-support：serenity 公开 API 引用 org.openqa.selenium.support.ui.*（如 ExpectedCondition），
             须随 serenity 一并显式声明，否则 javac 符号补全会 CompletionFailure（ENG-P0-2 下沉后原继承关系消失） -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>

        <!-- 测试期依赖（JUnit 4：与 runner 侧统一；原先的 JUnit5 套件收尾设施
             SuiteTeardownListener / junit-platform-launcher 已随之移除） -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WEB-P1-5：web 模块单测补充基础依赖（PageWaits/PageNavigation 等需 mock BasePage/Page）。
             版本与 test-automation 保持一致（4.5.1），避免 RequireUpperBoundDeps 校验冲突。 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- A-9 对称修复：serenity-core 已排除 selenium-java，但 Serenity 运行期（SerenityTestExecutionListener
             经 SupportedWebDriver 静态初始化）需加载各 driver 类，否则框架测试启动 NoClassDefFoundError。
             与 test-automation 一致补 selenium-java（test scope）提供 driver 类；版本与全局钉 4.23.1 对齐。 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 依赖治理：Cucumber 已从 serenity-model 的传递链路排除（见根 DM），而本模块**确实使用**它 ——
             ① src/main 的框架级 glue（ConcurrentExecutionGlue）直接用 io.cucumber.java.en.* 注解（cucumber-java）
                与 io.cucumber.datatable.DataTable（datatable），故必须为 compile 作用域；
             ② Serenity 运行期（StepEventBus → Serenity 的 Cucumber 集成）需 cucumber-core 可加载 ——
                这也是本模块单测加载 StepEventBus 时不再 NoClassDefFoundError 的前提。
             三者在此显式声明，版本由根 DM 统一钉 ${cucumber.version}，不随 Serenity 传递漂移。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>datatable</artifactId>
        </dependency>
    </dependencies>
</project>
