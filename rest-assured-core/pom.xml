<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>Automation_WebUI_Framework_BDD</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>rest-assured-core</artifactId>
    <name>rest-assured-core (API testing)</name>
    <description>API testing layer: framework.api (RestAssured). Depends on pw-core, reporting.</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ENG-P0-2：api 实际用到的外部依赖（原由根 <dependencies> 继承，现显式声明） -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <!-- P-7：响应契约校验（JSON Schema）。仅用 JSON 校验，故排除 YAML schema 传递依赖
             jackson-dataformat-yaml，避免其 2.17.1 与项目钉定的 jackson-core/databind 2.18.3 版本偏斜。 -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>jackson-dataformat-yaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
        </dependency>
        <!-- RestAssured POST 运行期需要 commons-logging(LogFactory)；serenity-* 已将其排除，此处显式补回 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <!-- selenium-support：serenity 公开 API 引用 org.openqa.selenium.support.ui.*（如 ExpectedCondition）。
             保留显式声明：与 web 同策略，防 ENG-P0-2 下沉后 javac 符号补全 CompletionFailure。 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>

        <!-- 评审08类-6 / A-4：api 模块首个单测基座 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
        <!-- 评审08类-6 / A-4：api 模块单测基座（Mockito 驱动 executeWithRetry 重试内核，
             绕开 SerenityRest 在纯 JUnit 下的 classloader 约束） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!--
          PAR-7 JaCoCo 行覆盖率下限（2026-09-17 首次落地，2026-09-20 上调至目标位）。
          口径：doc05 §5.2 建议「先设低门槛并只允许上升」。
          首版实测 = 23.5%（427/1818），下限取 0.23 以启动「只升不降」门禁。
          2026-09-20 补测：新增 HttpStatusTest / JsonUtilsTest / ApiLogSanitizerTest / FileReaderTest /
          EnvironmentUtilsTest / ConfigProviderTest（+2 测试资材），实测 LINE 覆盖率 = 43.1%（792/1836），
          故下限上调至 **0.40**（doc 中既定目标位），仍保留约 3pp 余量以防环境差异。
          若某次提交将 api 行覆盖率拉到 0.40 以下，verify 即失败（提示删测试 / 退化）。
        -->
        <api.line.coverage.floor>0.40</api.line.coverage.floor>
    </properties>

    <build>
        <plugins>
            <!-- PAR-7：api 模块自身覆盖率报告 + 门禁（prepare-agent 由父 POM 为所有模块注入） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- 在 test 阶段产出 api 模块自身的 XML 报告（此前仅在 test-automation 出报告） -->
                    <execution>
                        <id>api-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                    <!-- 门禁：BUNDLE 行覆盖率不得低于下限，否则 verify 失败（仅升不降） -->
                    <execution>
                        <id>api-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${api.line.coverage.floor}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
