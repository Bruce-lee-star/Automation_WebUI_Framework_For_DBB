<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>Automation_WebUI_Framework_BDD</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>framework-route</artifactId>
    <name>Automation Framework - Route</name>
    <description>API route/mock layer: framework.route. Depends on core (and reporting).
        NOTE: web does NOT depend on route — the web→route edge was broken via the core RouteLifecycle SPI (T3-1).
        NOTE: route no longer depends on web (ROUTE-P1-1): HikariConfigFactory / MonitorConfig / LanguageState 已下沉 core。</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-reporting</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- T2-7 阶段0：将 JSONPath 引擎提升为 route 的 direct 依赖（ENG-P0-2：版本改由根 dependencyManagement 统一钉） -->
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>

        <!-- ROUTE-P1-N2：Flyway 管理 route_monitor_record schema，DDL 移出 Java。
             flyway-core 内含 MySQL / PostgreSQL / H2 社区库迁移支持；Oracle/SQLServer 本就不支持
             （已在 init 前置 fail-fast 拒绝），无需额外模块。Java 17+ 兼容 JDK 21。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>9.22.3</version>
        </dependency>

        <!-- ENG-P0-2：route 实际用到的外部依赖（原由根 <dependencies> 继承，现显式声明） -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- D6-1：HikariConfigFactory 由 core 迁至 route（其唯一消费方），其隔离单测需真实 JDBC 驱动的内存库（版本与 core 对齐）。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
        <!-- D6-1：HikariConfigFactory 隔离单测随类迁至 route，需 JUnit 5（Jupiter，2026-09-11 升级，替代 junit:junit 4.13.2）。
             route 测试为纯 JUnit（不依赖 Serenity），故仅引入 junit-jupiter-*。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
