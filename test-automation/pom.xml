<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>Automation_WebUI_Framework_BDD</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>test-automation</artifactId>
    <name>Test Automation</name>
    <description>Cucumber/Serenity test suite: features, step definitions, CucumberTestRunnerIT. Aggregates all framework modules.</description>

    <properties>
        <!-- Cucumber 标签过滤：默认只跑 @test1；用 -Dtags=@其他 覆盖；-Dtags= （空串）跑全部 -->
        <tags>@test1</tags>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-reporting</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-route</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>framework-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ENG-P0-2：test-automation 实际用到的外部依赖（原由根 <dependencies> 继承，现显式声明；均为测试期） -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-cucumber</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5（Jupiter）：测试基座（2026-09-11 JUnit5 升级，替代 junit:junit 4.13.2） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cucumber runner 迁移为 @Suite（替代 @RunWith(CucumberWithSerenity)），驱动 cucumber-junit-platform-engine -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RestAssured POST 运行期需要 commons-logging(LogFactory)；serenity-* 已将其排除，此处显式补回 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- selenium-support：serenity 公开 API 引用 org.openqa.selenium.support.ui.*（如 ExpectedCondition）；
             测试源码用到 serenity 的 Wait/ExpectedCondition 签名，须显式声明否则 javac 符号补全会 CompletionFailure -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 纯单测：mock Playwright Page/BrowserContext，校验 start(page) 监听器幂等注册（不依赖浏览器运行时） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.5.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.12.23</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.objenesis</groupId>
            <artifactId>objenesis</artifactId>
            <version>3.2</version>
            <scope>test</scope>
        </dependency>
        <!-- T0-4 补全收尾：Monitor DB 持久化端到端验证（内存库，无需外部 DB） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <useFile>false</useFile>
                    <rerunFailingTestsCount>${rerunFailingTestsCount}</rerunFailingTestsCount>
                    <forkCount>1</forkCount>
                    <!-- Cucumber 主流程整体超时兜底（防 Playwright 导航/采集阻塞拖垮整轮） -->
                    <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/integration/**/*Test.java</include>
                        <include>**/CucumberTestRunner*.java</include>
                    </includes>
                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <useModulePath>false</useModulePath>
                    <!-- ⚠ JDK16+ 强封装：Serenity REST(RestSpecificationFactory) 在静态初始化时用 ByteBuddy
                         反射注入类，需 java.base 打开 java.lang(ClassLoader.getPackage/defineClass)；
                         java.lang.reflect 供 Mockito/Serenity 反射增强；java.util 供 RestAssured 的 Groovy 反射。 -->
                    <argLine>@{jacocoArgLine} -XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <serenity.outputDirectory>${project.build.directory}/site/serenity</serenity.outputDirectory>
                        <cucumber.filter.tags>${tags}</cucumber.filter.tags>
                    </systemPropertyVariables>
                    <failIfNoTests>false</failIfNoTests>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>net.serenity-bdd.maven.plugins</groupId>
                <artifactId>serenity-maven-plugin</artifactId>
                <version>${serenity.version}</version>
                <executions>
                    <execution>
                        <id>serenity-reports</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/serenity</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo：覆盖率探针（prepare-agent 在父 pom 注入）。
              当前单元测试为“行为护盾”（Mockito 隔离，验证委派转发），并不执行 framework-web 实现，
              故 framework-web 行覆盖率约 0%；覆盖率“只升不降”门禁（check）待 T1-9 补充真实覆盖测试后启用。
              此处仅出报告（聚焦刚拆分的 BasePage 包），便于 CI/人工查看覆盖缺口。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ⭐ 汇总报告生成（原 T2-8 自动化）：本模块内联 exec-maven-plugin 在 verify 阶段触发，
                 生命周期上晚于上方 serenity:aggregate 所在的 post-integration-test，
                 顺序由 Maven 阶段保证，不再依赖同阶段内的插件声明顺序。
                 仅本模块（唯一含 framework-reporting 的业务测试模块）执行，根与框架模块不触发。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-summary-report</id>
                        <phase>${summary.report.phase}</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.hsbc.cmb.hk.dbb.automation.framework.common.reporting.SummaryReportGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/site/serenity</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      ⭐ 共享 Browser 模式「Context 隔离」实浏览器 E2E（设计文档 §6 待办 ②）。
      默认关闭：本 E2E 仅在 serenity.playwright.shared.browser.enabled=true 时经 Assume 真正执行；
      普通 mvn test 该开关为 false → 类内 @BeforeClass 优雅跳过，零侵入默认每线程独立 Browser 模型。
      激活本 profile 后，surefire 在【独立 fork】中以共享开关启动 JVM，使 PlaywrightManager 的类加载期
      静态标志 SHARED_BROWSER_MODE 取 true，从而真实跑通单 Browser + 多 Context 的隔离验证（需浏览器环境）。
    -->
    <profiles>
        <profile>
            <id>shared-browser-e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>shared-browser-context-isolation-e2e</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/SharedBrowserContextIsolationE2E.java</include>
                                    </includes>
                                    <forkCount>1</forkCount>
                                    <reuseForks>false</reuseForks>
                                    <useModulePath>false</useModulePath>
                                    <failIfNoTests>false</failIfNoTests>
                                    <!-- JDK16+ 强封装：Playwright/Serenity 反射增强需要打开 java.base 内部包 -->
                                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
                                    <systemPropertyVariables>
                                        <serenity.playwright.shared.browser.enabled>true</serenity.playwright.shared.browser.enabled>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
